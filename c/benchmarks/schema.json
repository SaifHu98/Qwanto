{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Colibri Benchmark Record",
  "type": "object",
  "required": [
    "git_commit",
    "build_flags",
    "compiler",
    "os",
    "cpu",
    "ram_gb",
    "gpu_and_driver",
    "storage_device",
    "model_hash",
    "quantization",
    "context_size",
    "cache_state",
    "backend",
    "env_vars",
    "prompt_hash",
    "generated_tokens",
    "warmup_runs",
    "measured_repetitions",
    "median_tok_s",
    "p90_tok_s",
    "p95_tok_s",
    "stddev_tok_s",
    "peak_rss_mb",
    "gates_passed"
  ],
  "properties": {
    "git_commit": { "type": "string" },
    "build_flags": { "type": "string" },
    "compiler": { "type": "string" },
    "os": { "type": "string" },
    "cpu": { "type": "string" },
    "ram_gb": { "type": "number" },
    "gpu_and_driver": { "type": "string" },
    "storage_device": { "type": "string" },
    "model_hash": { "type": "string" },
    "quantization": { "type": "string" },
    "context_size": { "type": "integer" },
    "cache_state": { "type": "string" },
    "backend": { "type": "string" },
    "env_vars": { "type": "object", "additionalProperties": { "type": "string" } },
    "prompt_hash": { "type": "string" },
    "generated_tokens": { "type": "integer" },
    "warmup_runs": { "type": "integer" },
    "measured_repetitions": { "type": "integer" },
    "median_tok_s": { "type": "number" },
    "p90_tok_s": { "type": "number" },
    "p95_tok_s": { "type": "number" },
    "stddev_tok_s": { "type": "number" },
    "peak_rss_mb": { "type": "number" },
    "gates_passed": {
      "type": "object",
      "required": [
        "token_parity",
        "no_kv_corruption",
        "no_memory_leak",
        "no_deadlock",
        "no_stream_mismatch",
        "no_fd_thread_leak"
      ],
      "properties": {
        "token_parity": { "type": "boolean" },
        "no_kv_corruption": { "type": "boolean" },
        "no_memory_leak": { "type": "boolean" },
        "no_deadlock": { "type": "boolean" },
        "no_stream_mismatch": { "type": "boolean" },
        "no_fd_thread_leak": { "type": "boolean" }
      }
    }
  }
}
