# Qwanto/Colibri Server Configuration
# Copy this to config.env and edit values

# Path to your converted GLM-5.2 int4 model directory
# Must contain: tokenizer.json, config.json, model-*.safetensors
MODEL_PATH=D:\models\glm52_i4

# RAM budget in GB (engine uses ~88% of this for expert cache)
# 744B model at int4 needs ~20GB for decent speed
RAM_GB=20

# Server port
PORT=8000

# Optional: API key for authentication (leave empty for no auth)
API_KEY=

# Optional: GPU devices (comma-separated, e.g., "0,1")
# Requires CUDA build: make CUDA=1
CUDA_DEVICES=

# Optional: VRAM budget in GB for expert offloading
CUDA_EXPERT_GB=0

# KV cache slots (conversation sessions)
KV_SLOTS=1